  "non_negotiables": [
    {
      "id": "single_master",
      "statement": "Never invent a second master.",
      "check": "check_single_master"
    },
    {
      "id": "no_simulated_success",
      "statement": "Never simulate tool success - real read-back / exit codes only.",
      "check": "check_no_simulated_success"
    },
    {
      "id": "tool_extension_protocol",
      "statement": "Missing tool -> follow workflows/tool-extension.md.",
      "check": "check_tool_extension_protocol"
    },
    {
      "id": "smallest_patch",
      "statement": "Prefer the smallest patch that restores capability.",
      "check": "check_smallest_patch"
    },
    {
      "id": "read_before_act",
      "statement": "On uncertainty: read files first, then act.",
      "check": "check_read_before_act"
    }
  ],
